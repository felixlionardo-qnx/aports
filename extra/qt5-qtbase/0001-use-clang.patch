diff --git a/mkspecs/common/qcc-base-qnx.conf b/mkspecs/common/qcc-base-qnx.conf
index 4725371c29a..aefa712238c 100644
--- a/mkspecs/common/qcc-base-qnx.conf
+++ b/mkspecs/common/qcc-base-qnx.conf
@@ -24,6 +24,14 @@ QMAKE_LFLAGS_VERSION_SCRIPT = -Wl,--version-script,
 QMAKE_CFLAGS_THREAD     = -D_REENTRANT
 QMAKE_CXXFLAGS_THREAD   = $$QMAKE_CFLAGS_THREAD
 QMAKE_COMPILER_DEFINES += __QNXNTO__
+DEFINES += QT_POSIX_IPC
+
+# QNX's *_chk.h fortify wrappers need __builtin_va_arg_pack(), which clang
+# does not implement, so fortify cannot be used with this toolchain.
+DEFINES -= _FORTIFY_SOURCE=2
+
+QMAKE_CFLAGS           += -Wno-macro-redefined
+QMAKE_CXXFLAGS         += -Wno-macro-redefined
 
 QMAKE_LIBS              = -lm
 QMAKE_LIBS_NETWORK      = -lsocket
@@ -35,10 +43,9 @@ QMAKE_LIBS_EGL          = -lEGL
 # When using this mkspec to build Qt apps (ie - not Qt itself) we want to build
 # against the NDK's target directory which is referenced by the QNX_TARGET environment
 # variable, and which is guaranteed by the NDK to be set.
+isEmpty(QNX_HOST): QNX_HOST = /
+isEmpty(QNX_TARGET): QNX_TARGET = /
 QNX_DIR = $$(QNX_TARGET)
-isEmpty(QNX_DIR) {
-    error("QNX_TARGET environment variable not set")
-}
 
 QMAKE_INCDIR_POST       = $${QNX_DIR}/usr/include $${QNX_DIR}/usr/include/freetype2
 QMAKE_LIBDIR_POST       = $${QNX_DIR}/$${QNX_CPUDIR}/lib $${QNX_DIR}/$${QNX_CPUDIR}/usr/lib
