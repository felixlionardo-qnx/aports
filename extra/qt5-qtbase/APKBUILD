# Maintainer: Bart Ribbers <bribbers@disroot.org>
pkgname=qt5-qtbase
pkgver=5.15.18_git20251101
pkgrel=1
_module="${pkgname#qt5-}"
_pkgver=bebdfd54917e25d1c100e6bd9f5dd53c2e645fd8
_fullname=$_module-$_pkgver
pkgdesc="Qt5 - QtBase components"
url="https://qt.io/developers/"
arch="all"
license="LGPL-2.1-only AND LGPL-3.0-only AND GPL-3.0-only AND Qt-GPL-exception-1.0"
_sub="$pkgname-sqlite"
depends="at-spi2-core-libs
        brotli
        cairo
        cairo-gobject
        dbus
        double-conversion
        fontconfig
        freetype
        gdk-pixbuf
        glib
        gtk3
        harfbuzz
        icu-libs
        libb2
        libc++
        libcrypto3
        libintl
        libjpeg-turbo
        libpcre2-16
        libpng
        libssl3
        libxkbcommon
        md4c-libs
        pango
        tzdata
        wayland
        zlib-ng
        zstd-libs
        qnx-egl
        qnx-fs-notify
        qnx-gles
        qnx-io-sock
        qnx-libdrm
        qnx-libgbm
        qnx-libslog2
        qnx-screen
        "
depends_dev="$_sub
    clang
    dbus-dev
    double-conversion-dev
    fontconfig-dev
    freetype-dev
    glib-dev
    gobject-introspection-dev
    harfbuzz-dev
    icu-dev
    libb2-dev
    libc++-dev
    libjpeg-turbo-dev
    libpng-dev
