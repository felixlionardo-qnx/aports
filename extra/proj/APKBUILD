# Contributor: Holger Jaekel <holger.jaekel@gmx.de>
maintainer="Natanael Copa <ncopa@alpinelinux.org>"
pkgname=proj
pkgver=9.8.1
pkgrel=0
pkgdesc="PROJ coordinate transformation software library"
url="https://proj.org/"
arch="all"
license="MIT"
makedepends="
	cmake
	curl-dev
	nlohmann-json
	ninja
	sqlite
	sqlite-dev
	tiff-dev
	"
checkdepends="
	bash
	gtest-dev
	"
subpackages="
	$pkgname-doc
	$pkgname-util:util
	$pkgname-dev
	$pkgname-bash-completion
	"
source="
	https://download.osgeo.org/proj/proj-$pkgver.tar.gz
	"
options="!check"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=True \
		-DCMAKE_BUILD_TYPE=None \
		-DUSE_EXTERNAL_GTEST=ON \
		-DRUN_NETWORK_DEPENDENT_TESTS=OFF \
		-DBUILD_TESTING="$(want_check && echo ON || echo OFF)"
	cmake --build build
}

check() {
	ctest --test-dir build --force-new-ctest-process -E '(test_network)'
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

util() {
	pkgdesc="Cartographic projection library (utilities)"

	amove usr/bin
}


sha512sums="
